DJANGO_ENV=development
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=realestate
POSTGRES_USER=realestate
POSTGRES_PASSWORD=replace-with-a-strong-hex-password
DATABASE_URL=postgresql://realestate:replace-with-a-strong-hex-password@db:5432/realestate
EMAIL_URL=consolemail://
SECURE_SSL_REDIRECT=False
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_SECRET=
# Uploaded media storage. Prefer an IAM role in production; for local development,
# put credentials only in the gitignored .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=raha-static-bucket
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600
